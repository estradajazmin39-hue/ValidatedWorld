# ValidatedWorld AI semantic-review configuration (planned Gate B)
#
# This file documents supported environment-variable names. It contains no
# usable secret. ValidatedWorld will use .NET configuration/user-secrets and the
# process environment; it will not automatically search for or load a `.env`
# file. A launcher that supports dotenv files may use a private ignored `.env`.

# Non-secret settings. No model is selected implicitly.
VW_AIREVIEW__PROVIDER=openai
VW_AIREVIEW__MODEL=
VW_AIREVIEW__TIMEOUTSECONDS=120
VW_AIREVIEW__MAXINPUTTOKENS=
VW_AIREVIEW__MAXOUTPUTTOKENS=
VW_AIREVIEW__MAXREQUESTS=

# Secret. Leave blank in this tracked template.
# Prefer the already-initialized .NET Secret Manager store for source-checkout
# development. Gate B will add runtime loading; storing the value is safe now:
# dotnet user-secrets set "AiReview:OpenAI:ApiKey" "<key>" --project src/ValidatedWorld.Cli/ValidatedWorld.Cli.csproj
OPENAI_API_KEY=

# Live provider evaluations are never part of the default test suite. A future
# Gate B command/test harness must also require this explicit opt-in.
VW_AIREVIEW__LIVETESTS=false
