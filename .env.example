# ValidatedWorld AI semantic-review configuration (planned Gate B)
#
# This file documents supported environment-variable names. It contains no
# usable secret. ValidatedWorld will use .NET configuration/user-secrets and the
# process environment; it will not automatically search for or load a `.env`
# file. A launcher that supports dotenv files may use a private ignored `.env`.

# Non-secret settings. Gate B supports this one production provider/model.
VW_AIREVIEW__PROVIDER=openai
VW_AIREVIEW__MODEL=gpt-5.6-terra
# End-to-end deadline for one provider response. The planned implementation uses
# Responses background mode and polling for long-running reasoning rather than
# relying on one HTTP connection remaining open for twenty minutes.
VW_AIREVIEW__TIMEOUTSECONDS=1200

# Secret. Leave blank in this tracked template.
# Prefer the already-initialized .NET Secret Manager store for source-checkout
# development. Gate B will add runtime loading; storing the value is safe now:
# dotnet user-secrets set "AiReview:OpenAI:ApiKey" "<key>" --project src/ValidatedWorld.Cli/ValidatedWorld.Cli.csproj
OPENAI_API_KEY=

# Opt-in only for the separately invoked Gate B live-provider smoke/evaluation
# harness. Unit, integration, and ordinary end-to-end tests ignore this setting
# and never contact OpenAI.
VW_AIREVIEW__LIVETESTS=false

# Planned Gate C AI authoring/intake configuration. It uses the same human-owned
# OPENAI_API_KEY but a separate fixed-purpose client and live-test opt-in.
VW_AIAUTHORING__PROVIDER=openai
VW_AIAUTHORING__MODEL=gpt-5.6-terra
VW_AIAUTHORING__TIMEOUTSECONDS=1200
VW_AIAUTHORING__LIVETESTS=false
